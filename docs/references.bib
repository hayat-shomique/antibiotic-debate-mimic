  doi     = {10.1016/j.ijid.2026.108563},
  note    = {PMID 41864271. 17 studies. No significant difference in 30-day mortality between carbapenems and noncarbapenems, OR 1.29, 95 percent CI 0.91 to 1.82. Carbapenems associated with more adverse drug reactions, OR 4.32, 95 percent CI 1.73 to 10.79. Supports guidance recommending cefepime at a minimum inhibitory concentration of 2 or below},
